import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.feature_selection import f_classif
import os

# === 1. 读取数据 ===
input_csv_path = r"C:\Users\10655\Desktop\test\training_SEaTH.csv"
# 输出统计表的路径
output_csv_path = r"C:\Users\10655\Desktop\test\training_3D_top31_optimized.csv"
# 输出图片的根目录
output_img_root = r"C:\Users\10655\Desktop\test"

df = pd.read_csv(input_csv_path)
feature_cols = df.select_dtypes(include=['float64', 'int64']).columns
# 排除 landcover 标签列
feature_cols = [col for col in feature_cols if col != 'landcover']

X = df[feature_cols].values
y = df['landcover'].values
unique_classes = np.unique(y)

# [新增优化]：预先计算特征间的相关性矩阵，用于去冗余
# 这一步是为了确保选出的特征之间不高度相关（例如避免同时选中 B1 和 B1_1）
corr_matrix = df[feature_cols].corr().abs()

all_stats = []

# === 设置绘图风格 (保持不变) ===
# 设置字体为 Times New Roman 且字号为 38
plt.rcParams['font.family'] = 'Times New Roman'
plt.rcParams['font.size'] = 38

# === 2. 每类做一对多 Fisher 分析，并绘图 ===
print(f"正在处理数据，共 {len(unique_classes)} 个类别...")

for c in unique_classes:
    y_binary = (y == c).astype(int)
    f_values, _ = f_classif(X, y_binary)
    # 处理可能的 NaN 值
    f_values = np.nan_to_num(f_values)
    
    # 将 F-score 排序
    scores = pd.Series(f_values, index=feature_cols).sort_values(ascending=False)

    # === [优化核心]：筛选最优且不冗余的前3个波段 ===
    top_bands = []
    for candidate in scores.index:
        if len(top_bands) >= 3:
            break
            
        if not top_bands:
            top_bands.append(candidate)
        else:
            # 检查当前候选波段与已选波段的相关性
            is_redundant = False
            for selected in top_bands:
                # 如果相关系数 > 0.9，则认为是冗余特征，跳过
                if corr_matrix.loc[candidate, selected] > 0.90:
                    is_redundant = True
                    break
            
            if not is_redundant:
                top_bands.append(candidate)
    
    print(f"类别 {c} 的最优特征: {top_bands}")

    # === 下面的统计与绘图逻辑保持原样 ===
    for top_band in top_bands:
        positive = df[y == c][top_band]
        negative = df[y != c][top_band]

        full_min = min(positive.min(), negative.min())
        full_max = max(positive.max(), negative.max())
        bins = np.linspace(full_min, full_max, 31)

        pos_counts, _ = np.histogram(positive, bins=bins)
        neg_counts, _ = np.histogram(negative, bins=bins)

        pos_mean = positive.mean()
        pos_std = positive.std()
        pos_min = positive.min()
        pos_max = positive.max()
        pos_median = positive.median()
        threshold_min = pos_median - pos_std
        threshold_max = pos_median + pos_std
        f_score = scores[top_band]

        for i in range(len(bins) - 1):
            all_stats.append({
                'class': c,
                'top_band': top_band,
                'bin_left': bins[i],
                'bin_right': bins[i+1],
                'class_count': pos_counts[i],
                'others_count': neg_counts[i],
                'f_score': f_score,
                'mean': pos_mean,
                'std': pos_std,
                'min': pos_min,
                'max': pos_max,
                'median': pos_median,
                'threshold_min': threshold_min,
                'threshold_max': threshold_max
            })

        # === 3. 可视化并保存图像 ===
        plt.figure(figsize=(10, 6))
        plt.hist(positive, bins=30, alpha=0.5, label=f'{c}', color='red')
        plt.hist(negative, bins=30, alpha=0.3, label='Others', color='#8490CB')
        plt.axvline(threshold_min, color='red', linestyle='--')
        plt.axvline(threshold_max, color='green', linestyle='--')
        plt.xlabel(f'{c} - {top_band}')
        plt.ylabel('Frequency')
        plt.legend(frameon=False)
        plt.grid(True, linestyle='--', alpha=0.4)
        plt.tight_layout()

        # 输出路径（按类保存到子文件夹）
        output_dir = os.path.join(output_img_root, f"class_{c}")
        os.makedirs(output_dir, exist_ok=True)
        
        save_path = os.path.join(output_dir, f"{top_band}.png")
        plt.savefig(save_path, dpi=400, bbox_inches='tight')
        plt.close()

# === 4. 保存统计信息 ===
pd.DataFrame(all_stats).to_csv(output_csv_path, index=False)
print(f"处理完成！统计表已保存至: {output_csv_path}")
